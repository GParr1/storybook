{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "lib": [
      "ES2022"
    ],

    "jsx": "react-jsx",

    "skipLibCheck": true,

    "strict": true,

    "noEmit": true,

    "verbatimModuleSyntax": true,
    "moduleDetection": "force"
  },

  "include": [
    "src"
  ]
}